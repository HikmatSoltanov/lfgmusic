{
  "name": "lfgmusic",
  "version": "1.0.0",
  "private": true,
  "description": "Spotify Jam companion and licensed local-audio Discord player",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "register": "tsx src/register.ts",
    "test": "tsx --test test/*.test.ts",
    "doctor": "tsx src/doctor.ts",
    "init:env": "node scripts/init-env.mjs",
    "demo": "node scripts/demo-audio.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "opusscript": "0.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
