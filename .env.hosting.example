# Copy to .env and fill values locally, or use secure hosting variables.
# This example uses a Linux container with HTTPS reverse proxy.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Replace bot.example.org with YOUR reachable HTTPS domain.
SPOTIFY_REDIRECT_URI=https://bot.example.org/callback
PUBLIC_BASE_URL=https://bot.example.org
HTTP_HOST=0.0.0.0
# Replace 8888 with the actual HTTP port allocated by your hosting provider.
HTTP_PORT=8888
# Generate once with npm run init:env. Never change while retaining saved tokens.
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=./data/bot.sqlite
AUDIO_ROOT=./media
AUDIO_CATALOG=./media/catalog.json
FFMPEG_PATH=ffmpeg
SPOTIFY_POLL_MS=5000
EMBED_UPDATE_MS=15000

# Optional, only for scripts/start-with-tunnel.mjs. Never share this token.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional MusicBot-style audio engine (Linux x64 package, rights-confirmed sources).
MUSIC_ENGINE_ENABLED=0
MUSIC_ENGINE_SOURCE=youtube
MUSIC_ENGINE_PORT=2334
MUSIC_ENGINE_MAX_STREAMS=1
