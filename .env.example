# Node.js 24 LTS. Never commit .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register instantly on one test server. Empty = global commands.
DISCORD_GUILD_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match the Spotify dashboard; use 127.0.0.1, not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Required for a remote host: externally reachable HTTPS origin (no trailing slash).
# For Windows on the same PC, the default loopback address is sufficient.
PUBLIC_BASE_URL=http://127.0.0.1:8888
HTTP_HOST=127.0.0.1
HTTP_PORT=8888
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=./data/bot.sqlite
AUDIO_ROOT=./media
AUDIO_CATALOG=./media/catalog.json
FFMPEG_PATH=ffmpeg
SPOTIFY_POLL_MS=5000
EMBED_UPDATE_MS=15000
